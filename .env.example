# OpenAI API key - get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# GitHub personal access token - used by the CLI and manual PR review flow
GITHUB_TOKEN=ghp_...

# Database - local Docker example shown here; Render should use Supabase's pooled connection string
DATABASE_URL=postgresql+asyncpg://patchproof:patchproof@localhost:5432/patchproof

# GitHub App registration - used by Phase 5 webhooks
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/patchproof-github-app.private-key.pem
# Alternative for cloud hosts: paste the PEM as one env var with \n line breaks
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=change-me-webhook-secret

# Security - must be changed in production
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false

# Dashboard/API deployment settings
SERVE_DASHBOARD=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
