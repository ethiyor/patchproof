# PatchProof environment template
# Copy this file to .env and fill in only the values you need.
# Never commit .env or real credentials.

# Required for real LLM-backed reviews.
OPENAI_API_KEY=

# Optional: used by CLI GitHub PR review flows that rely on a personal token.
GITHUB_TOKEN=

# Local Docker Compose database URL.
DATABASE_URL=postgresql+asyncpg://patchproof:patchproof@localhost:5432/patchproof

# GitHub App automation. Required only for /github/webhook and PR comments.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Backend security/configuration.
SECRET_KEY=replace-with-a-long-random-local-secret
DEBUG=false
SERVE_DASHBOARD=true

# Comma-separated browser origins allowed to call the backend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
