# OpenAI API key - get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# GitHub personal access token - used by the CLI and manual PR review flow
GITHUB_TOKEN=ghp_...

# GitHub App registration - used by Phase 5 webhooks
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/patchproof-github-app.private-key.pem
GITHUB_WEBHOOK_SECRET=patchproof-local-webhook-secret-change-me
